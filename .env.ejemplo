# Plantilla de configuracion. Copiala a .env y llena los valores.
#   cp .env.ejemplo .env
#
# .env NUNCA se sube al repositorio (.gitignore ya lo excluye y la etapa 01 del
# pipeline lo vuelve a comprobar). Aqui no hay ni un valor real: solo marcadores.

# Entorno del despliegue: desarrollo | qa | produccion
ENTORNO=qa

# --- Base de datos (RDS PostgreSQL real de AWS Academy) ----------------------
# El host sale de: terraform output punto_conexion_base
#   (o de la consola de RDS, pestana Connectivity & security -> Endpoint)
URL_BASE_DATOS=postgresql+psycopg2://foro_admin:<contrasena-de-tu-rds>@<host-de-tu-rds>:5432/foro

# --- Almacenamiento de adjuntos (S3 real de AWS Academy) ---------------------
BUCKET_S3=CAMBIA_ESTE_VALOR
REGION_AWS=us-east-1

# Credenciales de AWS Academy. Si la instancia EC2 tiene un rol con acceso a S3,
# deja estas tres vacias: boto3 usa el rol y no hay credenciales que filtrar.
# Si usas las llaves temporales del Learner Lab, recuerda que caducan con la
# sesion del laboratorio y hay que actualizarlas.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# --- Sesiones -----------------------------------------------------------------
# Genera un valor unico y aleatorio (no lo escribas a mano):
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
CLAVE_SESION=CAMBIA_ESTE_VALOR
HORAS_SESION=8
# Ponla en true solo si sirves la app por HTTPS.
COOKIE_SEGURA=false

# --- Servicio de moderacion ---------------------------------------------------
# Dentro de docker compose el nombre del servicio resuelve solo.
URL_MODERADOR=http://moderador:8001
TIMEOUT_MODERADOR_SEG=5

# --- Limites de subida --------------------------------------------------------
MAX_BYTES_ADJUNTO=2097152

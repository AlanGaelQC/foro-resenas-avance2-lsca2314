# Secretos: nunca al repositorio.
.env
.env.*
!.env.ejemplo

# Estado y planes de Terraform: el archivo de estado guarda la contrasena de la
# base en claro, y el plan puede guardarla tambien.
infra/.terraform/
infra/*.tfstate
infra/*.tfstate.*
infra/*.tfvars
infra/*.tfvars.json
infra/*.tfplan
infra/crash.log

# Herramientas del pipeline instaladas localmente.
.herramientas/
venv/
.venv/

# Artefactos de Python.
__pycache__/
*.py[cod]
*.egg-info/

# Base de datos local de desarrollo (no es la RDS del entregable).
*.db
foro_desarrollo.db

# Reportes de trabajo del pipeline. Solo se entregan las dos corridas, los dos
# SBOM y el detalle minimo que permite auditar la corrida roja.
reportes/*
!reportes/.gitkeep
!reportes/corrida_roja.txt
!reportes/corrida_verde.txt
!reportes/sbom_cyclonedx.json
!reportes/sbom_cyclonedx_moderador.json
!reportes/evidencia_roja/
!reportes/evidencia_roja/04_sast_semgrep.txt
!reportes/evidencia_roja/08_pruebas_flujo.txt

# Sistema operativo y editores.
.DS_Store
.idea/
.vscode/
